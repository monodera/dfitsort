SIMPLE  =                    T / conforms to FITS standard
BITPIX  =                    8 / array data type
NAXIS   =                    2 / number of array dimensions
NAXIS1  =                    4
NAXIS2  =                    4
ORIGIN  = 'ESO-PARANAL'        / European Southern Observatory
TELESCOP= 'ESO-VLT-U1'         / ESO <TEL>
OBJECT  = 'NGC 255 '           / Original target.
EXPTIME =                 20.0 / Integration time
MJD-OBS =              60002.5 / Obs start
HIERARCH ESO DPR CATG = 'SCIENCE ' / Observation category
HIERARCH ESO DPR TYPE = 'STD     ' / Observation type
HIERARCH ESO DET DIT = 5.0 / Integration Time
HIERARCH ESO DET NDIT = 3 / # of Sub-Integrations
HIERARCH ESO INS FILT1 NAME = 'J       ' / Filter name.
HIERARCH ESO OBS PROG ID = '0118.A-0001(A)' / ESO program identification
LONGSTR = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&'
CONTINUE  'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&'
CONTINUE  'xxxxxxxxxxxxxxxx end'
QUOTED  = 'it''s / not a comment' / real comment
HIERARCH ESO OBS TARG NAME = 'O''Brien / field'
END
