====> file mef.fits (main) <====
SIMPLE  =                    T / conforms to FITS standard
BITPIX  =                    8 / array data type
NAXIS   =                    0 / number of array dimensions
EXTEND  =                    T
ORIGIN  = 'ESO-PARANAL'        / European Southern Observatory
TELESCOP= 'ESO-VLT-U1'         / ESO <TEL>
OBJECT  = 'NGC 254 '           / Original target.
EXPTIME =                 10.0 / Integration time
MJD-OBS =              60001.5 / Obs start
HIERARCH ESO DPR CATG = 'CALIB   ' / Observation category
HIERARCH ESO DPR TYPE = 'FLAT    ' / Observation type
HIERARCH ESO DET DIT = 2.5 / Integration Time
HIERARCH ESO DET NDIT = 2 / # of Sub-Integrations
HIERARCH ESO INS FILT1 NAME = 'H       ' / Filter name.
HIERARCH ESO OBS PROG ID = '0118.A-0001(A)' / ESO program identification
END
====> xtension 1
XTENSION= 'IMAGE   '           / Image extension
BITPIX  =                   16 / array data type
NAXIS   =                    2 / number of array dimensions
NAXIS1  =                   16
NAXIS2  =                    8
PCOUNT  =                    0 / number of parameters
GCOUNT  =                    1 / number of groups
EXTNAME = 'CHIP1   '           / extension name
EXTVER  =                    1
HIERARCH ESO DET CHIP ID = 'CCD-1   '
END
